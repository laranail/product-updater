{
    "name": "laranail/product-updater",
    "description": "Self-update engine for licensed Laravel products \u2014 checks an update source, downloads and verifies release archives, extracts files, runs migrations and publishes assets. License-gated via laranail/license-verifier.",
    "keywords": [
        "laravel",
        "updater",
        "self-update",
        "license",
        "laranail"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/product-updater",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://opensource.simtabi.com",
            "role": "Organization"
        },
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/laranail/product-updater/issues",
        "source": "https://github.com/laranail/product-updater",
        "docs": "https://opensource.simtabi.com/documentation/laranail/product-updater/"
    },
    "require": {
        "php": "^8.4.1 || ^8.5",
        "ext-zip": "*",
        "illuminate/support": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/filesystem": "^13.0",
        "laranail/package-tools": "^0.1",
        "laranail/license-verifier": "^0.1",
        "laranail/console": "^0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.6 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.5.8"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Product\\Updater\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Product\\Updater\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest --colors=always",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "lint": [
            "@pint",
            "@analyse",
            "@rector"
        ],
        "pint": "@php vendor/bin/laranail-pint --test",
        "format": "@pint-fix",
        "rector": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Product\\Updater\\Providers\\ProductUpdaterServiceProvider"
            ],
            "aliases": {
                "ProductUpdater": "Simtabi\\Laranail\\Product\\Updater\\Facades\\ProductUpdater"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/license-verifier"
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org",
            "exclude": [
                "laranail/*"
            ]
        },
        {
            "packagist.org": false
        }
    ]
}
